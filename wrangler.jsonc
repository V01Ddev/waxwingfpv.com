{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Matches the Worker the Cloudflare dashboard created. Deploying under a
  // different name would stand up a second Worker and orphan the custom domain
  // attached to this one.
  "name": "waxwingfpv-com",
  // Must not exceed the newest date the installed wrangler knows about; it
  // rejects anything later as "in the future". wrangler 4.149.0 ships
  // workerd 1.20261006.1, so this tracks that. Bump both together.
  "compatibility_date": "2026-10-06",

  // Static-only Worker: no `main`, so asset requests never invoke code and are
  // served free and unlimited. Everything the site does — the WhatsApp handoff,
  // analytics — happens in the browser.
  "assets": {
    "directory": "./dist",

    // All four canonical URLs end in a slash (/privacy/, /en/), so the default
    // auto-trailing-slash matches them exactly and redirects the slashless
    // form rather than 404ing it. Set explicitly rather than left implicit.
    "html_handling": "auto-trailing-slash",

    // The default here is "none", which would return a bare platform 404 and
    // throw away dist/404.html. This is the setting that makes the 404 real.
    // Worth stating why it matters: the Cloudflare dashboard's first connected
    // build generated its own config and ignored this file entirely, and the
    // live 404 was a zero-byte response until this was actually applied.
    "not_found_handling": "404-page"
  },

  // Stated rather than left to default, because both defaults are only
  // *implied* and wrangler warns about them on every deploy. workers.dev stays
  // on as the way to check a deploy before the custom domain exists; preview
  // URLs are a Workers Builds feature and are not used by GitHub Actions.
  "workers_dev": true,
  "preview_urls": false
}
