---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import {
  type Locale,
  htmlLang,
  ogLocale,
  localePath,
  locales,
  defaultLocale,
  t,
} from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path without any locale prefix, used for canonical + hreflang. */
  barePath?: string;
  /** Optional OG image, absolute path from /public. Omitted until Phase 5. */
  ogImage?: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  barePath = '/',
  ogImage,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://waxwingfpv.com');
const canonical = new URL(localePath(locale, barePath), site).href;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      locales.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt === 'tr' ? 'tr-TR' : 'en'}
          href={new URL(localePath(alt, barePath), site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(defaultLocale, barePath), site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WaxWingFPV" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0F1418" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Two faces, preloaded: the display face used in the headline and the
        body face. The latin-ext subsets are discovered by unicode-range as
        soon as the parser meets a Turkish character, which for a TR page is
        in the first heading — so they do not need a preload of their own. */}
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plex-sans-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/*
      GoatCounter. Cookieless, so no consent banner is needed for it.

      The beacon is loaded on idle rather than in the head, because an async
      third-party script still competes for bandwidth and a main-thread slot
      with the hero poster, which is the LCP element. The timeout means it
      still loads on a busy page.
    */}
    <script is:inline>
      (function () {
        var load = function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://gc.zgo.at/count.js';
          s.setAttribute('data-goatcounter', 'https://waxwingfpv.goatcounter.com/count');
          document.head.appendChild(s);
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(load, { timeout: 2000 });
        } else {
          window.addEventListener('load', load);
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t(locale, 'a11y.skipToContent')}</a>
    <slot />
  </body>
</html>
