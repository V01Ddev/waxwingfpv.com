---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import {
  type Locale,
  htmlLang,
  ogLocale,
  localePath,
  locales,
  defaultLocale,
  t,
} from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path without any locale prefix, used for canonical + hreflang. */
  barePath?: string;
  /** Absolute path from /public, e.g. /og/tr.jpg. */
  ogImage?: string;
  /** One-sentence description of the image, for screen readers and unfurlers. */
  ogImageAlt?: string;
  /** schema.org graph, rendered as JSON-LD. */
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  barePath = '/',
  ogImage,
  ogImageAlt,
  structuredData,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://waxwingfpv.com');
const canonical = new URL(localePath(locale, barePath), site).href;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      locales.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt === 'tr' ? 'tr-TR' : 'en'}
          href={new URL(localePath(alt, barePath), site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(defaultLocale, barePath), site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WaxWingFPV" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          {/* Declared so unfurlers can lay the card out before fetching it. */}
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
          <meta name="twitter:image" content={ogImageUrl} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0F1418" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      The SVG above adapts itself with prefers-color-scheme, but Safari does not
      read SVG favicons and a baked PNG cannot adapt — so both schemes are
      offered and the browser picks.

      Order matters. The light-scheme link comes first and the dark-scheme link
      second, so a browser that ignores `media` on a link matches both and takes
      the last one: white, which is the same default the SVG uses. Reversing
      these would hand a dark mark to browsers that cannot adapt, and it would
      vanish on dark chrome — the mirror of the problem this solves.
    */}
    <link
      rel="icon"
      href="/icons/favicon-32-dark.png"
      sizes="32x32"
      type="image/png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/icons/favicon-32.png"
      sizes="32x32"
      type="image/png"
      media="(prefers-color-scheme: dark)"
    />

    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Two faces, preloaded: the display face used in the headline and the
        body face. The latin-ext subsets are discovered by unicode-range as
        soon as the parser meets a Turkish character, which for a TR page is
        in the first heading — so they do not need a preload of their own. */}
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plex-sans-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/*
      GoatCounter. Cookieless, so no consent banner is needed for it.

      The beacon is loaded on idle rather than in the head, because an async
      third-party script still competes for bandwidth and a main-thread slot
      with the hero poster, which is the LCP element. The timeout means it
      still loads on a busy page.
    */}
    <script is:inline>
      (function () {
        var load = function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://gc.zgo.at/count.js';
          s.setAttribute('data-goatcounter', 'https://waxwingfpv.goatcounter.com/count');
          document.head.appendChild(s);
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(load, { timeout: 2000 });
        } else {
          window.addEventListener('load', load);
        }
      })();
    </script>
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">{t(locale, 'a11y.skipToContent')}</a>
    <slot />
  </body>
</html>
