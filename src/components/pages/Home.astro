---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import Hero from '../sections/Hero.astro';
import Work from '../sections/Work.astro';
import Kit from '../sections/Kit.astro';
import Services from '../sections/Services.astro';
import Process from '../sections/Process.astro';
import Trust from '../sections/Trust.astro';
import Contact from '../sections/Contact.astro';
import Lightbox from '../work/Lightbox.astro';
import { t, type Locale } from '../../i18n/ui';
import { getProjects, getSite } from '../../lib/content';
import { structuredData } from '../../lib/seo';

/**
 * The home page for both locales. Keeping one component rather than two
 * near-identical page files is the only way the two languages stay in step —
 * a change to the section order cannot land in Turkish and miss English.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const site = await getSite();
const projects = await getProjects(locale);
const origin = Astro.site ?? new URL('https://waxwingfpv.com');

const description = t(locale, 'site.description');
const ogImage = `/og/${locale}.jpg`;

const jsonLd = structuredData({
  locale,
  origin,
  name: t(locale, 'site.name'),
  description,
  telephone: site.whatsappDisplay,
  email: site.email,
  serviceArea: site.serviceArea(locale),
  instagram: site.instagram,
  licences: site.licences(locale),
  services: site.services(locale),
  projects,
  ogImage,
});
---

<BaseLayout
  locale={locale}
  title={t(locale, 'site.title')}
  description={description}
  barePath="/"
  ogImage={ogImage}
  ogImageAlt={t(locale, 'site.ogAlt')}
  structuredData={jsonLd}
>
  <Header locale={locale} barePath="/" />

  <main id="main">
    <Hero locale={locale} />
    <Work locale={locale} />
    <Kit locale={locale} />
    <Services locale={locale} />
    <Process locale={locale} />
    <Trust locale={locale} />
    <Contact locale={locale} />
  </main>

  <Footer locale={locale} />

  {/* One dialog serves every video on the page. */}
  <Lightbox locale={locale} />
</BaseLayout>
