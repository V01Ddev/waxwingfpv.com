---
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/**
 * One dialog for every video on the page. Triggers carry their own data, so
 * the component needs to know nothing about projects or kit — the list is
 * whatever `[data-video-src]` elements exist, in document order.
 *
 * Native <dialog>.showModal() gives the focus trap, Escape handling and
 * ::backdrop for free; hand-rolling those is where accessible modals
 * usually go wrong.
 */
---

<dialog
  class="lb"
  id="lightbox"
  aria-labelledby="lb-title"
  data-source-template={t(locale, 'media.sourceNote')}
>
  <div class="lb__frame">
    <div class="lb__bar">
      <p class="lb__count t-mono" data-lb-count></p>
      <button class="lb__close" type="button" data-lb-close>
        {t(locale, 'a11y.closeLightbox')}
        <span aria-hidden="true" class="lb__x"></span>
      </button>
    </div>

    <div class="lb__stage">
      <div class="lb__media" data-lb-media></div>

      <div class="lb__meta">
        <h2 class="lb__title" id="lb-title" data-lb-title></h2>
        <p class="lb__label t-mono" data-lb-label></p>
        {/* Says what the master actually is and that the web copy is smaller.
            Without it, a 540p clip on a 4K screen reads as the ceiling of the
            work rather than a delivery choice. */}
        <p class="lb__source t-mono" data-lb-source hidden></p>
        <dl class="lb__facts" data-lb-facts></dl>
      </div>
    </div>

    <div class="lb__nav">
      <button class="lb__step" type="button" data-lb-prev>
        <span aria-hidden="true">←</span>
        <span class="visually-hidden">{t(locale, 'a11y.previousVideo')}</span>
      </button>
      <button class="lb__step" type="button" data-lb-next>
        <span class="visually-hidden">{t(locale, 'a11y.nextVideo')}</span>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  .lb {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
  }

  .lb::backdrop {
    /* 0.97, not 0.94: at 0.94 the hero headline behind stayed legible enough
       to compete with the lightbox's own title, which sits right over it. */
    background: rgb(5 7 10 / 0.97);
  }

  .lb__frame {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-3) var(--gutter) var(--sp-4);
  }

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    flex: none;
  }

  .lb__count {
    color: var(--fg-muted);
    margin: 0;
  }

  .lb__close {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 44px;
    padding: 0 var(--sp-3);
    background: none;
    border: 0;
    color: var(--fg);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .lb__x {
    position: relative;
    width: 1rem;
    height: 1rem;
  }

  .lb__x::before,
  .lb__x::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 100%;
    height: var(--hairline);
    background: currentColor;
  }

  .lb__x::before {
    rotate: 45deg;
  }
  .lb__x::after {
    rotate: -45deg;
  }

  /* --- stage --- */
  /* The stage is the leftover height after the bar and the pager. The media
     flexes into it and the video fits inside that, so nothing can overflow the
     dialog — which is what previously pushed a vertical cut off a laptop
     screen and forced the visitor to scroll. */
  .lb__stage {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-5);
    width: 100%;
    /* 72rem = 1152px, just under the 1280px source width, so the 720p-class
       file is never upscaled. */
    max-width: 72rem;
    margin-inline: auto;
  }

  .lb__media {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    /* The video is absolutely positioned inside this box. A percentage
       max-height does not resolve against a stretched flex item, which is why
       the video used to render at its intrinsic size; against a positioned
       containing block it does. */
    position: relative;
  }

  .lb__media :global(video.is-capped::-webkit-media-controls-fullscreen-button) {
    display: none;
  }

  .lb__media :global(video) {
    /* inset: 0 with auto margins centres it, and max-width/height: 100%
       resolve against this box, so the video always fits exactly the space
       left after the meta. auto width/height keeps the element box equal to
       the rendered picture, so the hairline frames the video and not a
       letterbox around it. */
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    background: var(--mask);
    border: var(--hairline) solid var(--line);
  }

  /*
    :global() throughout this block. Astro scopes a rule to the last element in
    the selector, and the <video> and the fact rows are created by JavaScript,
    so they never carry the scope attribute and every rule aimed at them
    matched nothing.

    There is deliberately no svh cap here any more. Guessing the chrome height
    in svh is what produced the overlap: the reserve assumed a 16rem chrome,
    but for a landscape cut the meta adds 148px on top of the bar and pager, so
    the video came out 56px taller than its own container and sat over the
    title.
  */

  .lb__meta {
    /* flex: none, not shrinkable. It holds the title, and when it was allowed
       to be squeezed the title lost the fight with the video. */
    flex: none;
    display: grid;
    gap: var(--sp-2);
    justify-items: center;
    text-align: center;
    max-width: 60ch;
  }

  .lb__title {
    font-size: var(--text-xl);
  }

  .lb__label {
    color: var(--fg-muted);
    margin: 0;
  }

  .lb__source {
    color: var(--fg-muted);
    margin: 0;
  }

  .lb__source[hidden] {
    display: none;
  }

  .lb__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2) var(--sp-5);
    margin: var(--sp-2) 0 0;
  }

  .lb__facts :global(div) {
    display: flex;
    gap: var(--sp-2);
    align-items: baseline;
  }

  .lb__facts :global(dt) {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  .lb__facts :global(dd) {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--ls-mono);
  }

  /* --- paging --- */
  .lb__nav {
    display: flex;
    justify-content: space-between;
    flex: none;
  }

  .lb__step {
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--sp-4);
    background: none;
    border: var(--hairline) solid var(--edge-strong);
    color: var(--fg);
    font-size: var(--text-lg);
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease);
  }

  .lb__step:hover {
    border-color: var(--silk);
  }

  @media (min-width: 60rem) {
    /* Vertical cuts get a side column for the text rather than a caption
       under a very tall video. */
    .lb[data-orientation='vertical'] .lb__stage {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
      gap: var(--sp-7);
    }

    /* stretch gives the media a definite height for max-height: 100% to
       resolve against. */
    .lb[data-orientation='vertical'] .lb__media {
      flex: 1 1 auto;
      width: auto;
      min-width: 0;
    }

    .lb[data-orientation='vertical'] .lb__meta {
      flex: 0 0 18rem;
      align-self: center;
      justify-items: start;
      text-align: start;
    }

    .lb[data-orientation='vertical'] .lb__facts {
      justify-content: flex-start;
    }
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const media = dialog.querySelector<HTMLElement>('[data-lb-media]')!;
    const titleEl = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const labelEl = dialog.querySelector<HTMLElement>('[data-lb-label]')!;
    const factsEl = dialog.querySelector<HTMLElement>('[data-lb-facts]')!;
    const countEl = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const sourceEl = dialog.querySelector<HTMLElement>('[data-lb-source]')!;
    const sourceTemplate = dialog.dataset.sourceTemplate ?? '{source}';

    let triggers: HTMLElement[] = [];
    let index = 0;

    const read = (el: HTMLElement) => ({
      src: el.dataset.videoSrc ?? '',
      poster: el.dataset.videoPoster ?? '',
      title: el.dataset.videoTitle ?? '',
      label: el.dataset.videoLabel ?? '',
      orientation: el.dataset.videoOrientation ?? 'landscape',
      source: el.dataset.videoSource ?? '',
      noFullscreen: el.hasAttribute('data-video-nofullscreen'),
      facts: JSON.parse(el.dataset.videoFacts || '[]') as [string, string][],
    });

    function render(i: number) {
      const item = read(triggers[i]);
      dialog!.dataset.orientation = item.orientation;
      dialog!.setAttribute('aria-label', item.title);

      titleEl.textContent = item.title;
      labelEl.textContent = item.label;
      countEl.textContent = `${String(i + 1).padStart(2, '0')} / ${String(
        triggers.length
      ).padStart(2, '0')}`;

      sourceEl.hidden = !item.source;
      sourceEl.textContent = item.source
        ? sourceTemplate.replace('{source}', item.source)
        : '';

      factsEl.replaceChildren(
        ...item.facts.map(([term, value]) => {
          const row = document.createElement('div');
          const dt = document.createElement('dt');
          const dd = document.createElement('dd');
          dt.textContent = term;
          dd.textContent = value;
          row.append(dt, dd);
          return row;
        })
      );

      const video = document.createElement('video');
      video.controls = true;
      video.playsInline = true;
      video.preload = 'metadata';
      video.poster = item.poster;
      video.src = item.src;
      // The visitor clicked a play control, so this is a user gesture and
      // sound is expected rather than an ambush.
      video.autoplay = true;
      video.setAttribute('aria-label', `${item.title}, ${item.label}`);

      if (item.noFullscreen) {
        // controlsList is what Chrome honours; the CSS rule below catches the
        // WebKit button, and the double-click guard covers the rest.
        video.setAttribute('controlslist', 'nofullscreen nodownload');
        video.setAttribute('disablepictureinpicture', '');
        video.classList.add('is-capped');
        video.addEventListener('dblclick', (event) => event.preventDefault());
      }

      media.replaceChildren(video);
    }

    function open(el: HTMLElement) {
      triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-video-src]'));
      index = Math.max(0, triggers.indexOf(el));
      render(index);
      dialog!.showModal();
      document.body.style.overflow = 'hidden';
    }

    function step(delta: number) {
      index = (index + delta + triggers.length) % triggers.length;
      render(index);
    }

    function close() {
      dialog!.close();
    }

    dialog.addEventListener('close', () => {
      media.replaceChildren(); // stops playback and drops the buffer
      document.body.style.overflow = '';
      triggers[index]?.focus();
    });

    dialog.addEventListener('click', (event) => {
      // Clicks land on the dialog itself only when they hit the backdrop.
      if (event.target === dialog) close();
    });

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => step(-1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => step(1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      }
    });

    // Kick playback off once the first frames are in, so the poster does not
    // sit there while the video is still buffering.
    media.addEventListener(
      'loadeddata',
      (event) => {
        const video = event.target as HTMLVideoElement;
        video.play().catch(() => {
          /* autoplay refused — native controls are right there */
        });
      },
      { once: true }
    );

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-video-src]');
      if (trigger) {
        event.preventDefault();
        open(trigger);
      }
    });
  }
</script>
