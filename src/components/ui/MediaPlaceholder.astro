---
/**
 * A stand-in for video and photography, so a section can be laid out before
 * its asset exists. It renders a hatched block at the real aspect ratio, so it
 * occupies exactly the space the final media will and no layout shift is
 * hidden by its absence.
 *
 * Kit.astro still uses it as the fallback for an aircraft that has no sample
 * clip; every aircraft currently has one, so the branch does not render. No
 * script lists what is left — an earlier comment here named one that was
 * never written.
 */
interface Props {
  /** e.g. "16:9" or "9:16". Omit when `fill` is set. */
  ratio?: string;
  label: string;
  /** Fill the parent instead of reserving an aspect box. */
  fill?: boolean;
  class?: string;
}

const { ratio = '16:9', label, fill = false, class: className } = Astro.props;
const [w, h] = ratio.split(':').map(Number);
---

<div
  class:list={['ph', fill && 'ph--fill', className]}
  style={fill ? undefined : `--ar: ${w} / ${h}`}
  role="img"
  aria-label={`Placeholder for ${label}`}
>
  <span class="ph__label t-mono">{label}</span>
</div>

<style>
  .ph {
    aspect-ratio: var(--ar);
    display: grid;
    place-items: center;
    width: 100%;
    border: var(--hairline) solid var(--line);
    background-color: var(--bg-raised);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 11px,
      rgb(255 255 255 / 0.022) 11px 12px
    );
  }

  .ph--fill {
    aspect-ratio: auto;
    position: absolute;
    inset: 0;
    border: 0;
  }

  .ph__label {
    padding: var(--sp-2) var(--sp-3);
    background: var(--bg);
    border: var(--hairline) solid var(--line);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-align: center;
  }
</style>
