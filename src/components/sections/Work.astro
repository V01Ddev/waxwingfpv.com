---
import { t, type Locale } from '../../i18n/ui';
import { getProjects, getKit, formatDuration } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = await getProjects(locale);
const kit = await getKit(locale);

const kitName = (id: string) => kit.find((k) => k.id === id)?.name ?? id;
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="page">
    <div class="work__head">
      <h2 id="work-title">{t(locale, 'work.heading')}</h2>
      <p class="t-meta measure">{t(locale, 'work.intro')}</p>
    </div>

    {
      projects.map((project) => {
        const facts: [string, string][] = [
          [t(locale, 'work.shotOn'), kitName(project.gear.airframe)],
          [t(locale, 'work.camera'), project.gear.camera],
          [t(locale, 'work.place'), project.location],
        ];
        const single = project.cuts.length === 1;

        return (
          <article class="proj">
            <div class:list={['proj__pair', single && 'proj__pair--single']}>
              {project.cuts.map((cut) => {
                const duration = formatDuration(cut.durationSec);
                return (
                  <button
                    type="button"
                    class:list={[
                      'frame',
                      cut.orientation === 'vertical' ? 'frame--tall' : 'frame--wide',
                    ]}
                    data-video-src={cut.src}
                    data-video-poster={cut.poster}
                    data-video-title={project.title}
                    data-video-label={cut.label}
                    data-video-orientation={cut.orientation}
                    data-video-facts={JSON.stringify(
                      duration ? [...facts, [t(locale, 'work.duration'), duration]] : facts
                    )}
                  >
                    <span class="frame__media">
                      <img
                        src={cut.poster}
                        width={cut.width}
                        height={cut.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="frame__play">
                      <svg class="frame__tri" viewBox="0 0 12 14" aria-hidden="true" focusable="false">
                        <path d="M0 0 12 7 0 14Z" />
                      </svg>
                    </span>
                    <span class="frame__tag t-mono">
                      {cut.label}
                      {duration && <span class="frame__dur"> · {duration}</span>}
                    </span>
                    <span class="visually-hidden">
                      {t(locale, 'a11y.playVideo')} — {project.title} — {cut.label}
                    </span>
                  </button>
                );
              })}

              <div class="proj__meta">
                <h3 class="proj__title">
                  {project.title}
                  <span class="proj__place t-mono">
                    {project.clientType} · {project.location}
                  </span>
                </h3>

                <dl class="proj__facts">
                  <div class="proj__fact">
                    <dt class="t-mono">{t(locale, 'work.wanted')}</dt>
                    <dd>{project.goal}</dd>
                  </div>
                  <div class="proj__fact">
                    <dt class="t-mono">{t(locale, 'work.result')}</dt>
                    <dd>{project.result}</dd>
                  </div>
                </dl>

                <p class="proj__desc t-meta">{project.description}</p>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .work__head {
    display: grid;
    gap: var(--sp-4);
    margin-block-end: var(--sp-7);
  }

  .proj + .proj {
    margin-block-start: var(--sp-8);
  }

  /*
    The pair. Both cuts top-aligned so the vertical frame simply runs longer
    than the horizontal one — the difference in height IS the information
    ("you get both"), and nothing overlaps, so it survives every breakpoint
    without transform maths.
    The 0.32fr column is the ratio at which a 9:16 frame beside a 16:9 frame
    ends at exactly the same height (0.3164 = 81/256), so the two cuts read as
    one deliberate pair rather than two boxes that almost line up.
  */
  .proj__pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .proj__pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.32fr);
      gap: var(--sp-5);
    }

    .frame--wide {
      grid-column: 1;
    }
    .frame--tall {
      grid-column: 2;
    }
    .proj__meta {
      grid-column: 1;
    }

    /* A project with only one cut puts the text beside the video instead of
       leaving a hole where the second frame would be. Milat is the case in
       point: its only export is 1080x1920. */
    .proj__pair--single {
      grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
      align-items: start;
    }

    .proj__pair--single .frame--tall {
      grid-column: 1;
    }

    .proj__pair--single .proj__meta {
      grid-column: 2;
      padding-block-start: var(--sp-5);
    }
  }

  /* --- a single cut --- */
  .frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: start;
  }

  @media (max-width: 47.999rem) {
    /* On a phone the vertical cut holds a phone-shaped column, not full
       width — shown at the size it will actually be watched. */
    .frame--tall {
      max-width: 62%;
    }
  }

  .frame__media {
    display: block;
    border: var(--hairline) solid var(--line);
    overflow: hidden;
  }

  .frame__media img {
    width: 100%;
    height: auto;
  }

  .frame__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    translate: -50% -50%;
    background: rgb(5 7 10 / 0.62);
    border: var(--hairline) solid rgb(232 230 225 / 0.35);
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }

  .frame__tri {
    width: 0.85rem;
    height: auto;
    fill: var(--fg-muted);
    transition: fill var(--dur-2) var(--ease);
  }

  .frame:hover .frame__play,
  .frame:focus-visible .frame__play {
    background: rgb(5 7 10 / 0.85);
    border-color: var(--silk);
  }

  /* With no hue to signal state, tone still has to move the way people
     expect: rest is muted, hover and focus brighten. */
  .frame:hover .frame__tri,
  .frame:focus-visible .frame__tri {
    fill: var(--silk);
  }

  .frame__tag {
    position: absolute;
    inset-block-end: var(--sp-3);
    inset-inline-start: var(--sp-3);
    padding: var(--sp-1) var(--sp-2);
    background: rgb(5 7 10 / 0.78);
    color: var(--silk);
    font-size: var(--text-xs);
  }

  .frame__dur {
    color: var(--fg-muted);
  }

  /* --- project meta --- */
  .proj__meta {
    display: grid;
    gap: var(--sp-4);
    align-content: start;
    padding-block-start: var(--sp-2);
  }

  .proj__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3);
    font-size: var(--text-xl);
  }

  .proj__place {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .proj__facts {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    max-width: 52ch;
  }

  .proj__fact {
    display: grid;
    gap: var(--sp-1);
  }

  .proj__fact dt {
    color: var(--silk);
    font-size: var(--text-xs);
  }

  .proj__fact dd {
    margin: 0;
    color: var(--fg-muted);
  }

  .proj__desc {
    max-width: 56ch;
  }
</style>
