---
import MediaPlaceholder from '../ui/MediaPlaceholder.astro';
import Glint from '../brand/Glint.astro';
import { t, type Locale } from '../../i18n/ui';
import { getKit } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = await getKit(locale);

/**
 * The comparison is aircraft-only. A camera has no flight time and no control
 * link; forcing it into the same table produced eighteen rows of which ten
 * were em dashes. A table whose job is comparison should only contain things
 * that can be compared — the camera's own specs live in its panel instead.
 */
const airframes = items.filter((item) => item.kind === 'airframe');

/**
 * Rows every airframe can answer, in the order the first one lists them.
 * Derived from the data rather than hardcoded, so adding a spec to both
 * aircraft makes it appear here with no component change.
 */
const rows = airframes.length
  ? airframes[0].specs
      .map((spec) => spec.label)
      .filter((label) =>
        airframes.every((airframe) => airframe.specs.some((s) => s.label === label))
      )
  : [];

const valueFor = (item: (typeof items)[number], label: string) =>
  item.specs.find((s) => s.label === label)?.value ?? '—';
---

<section class="section kit" id="kit" aria-labelledby="kit-title">
  <div class="page">
    <div class="kit__head">
      <h2 id="kit-title">{t(locale, 'kit.heading')}</h2>
      <p class="t-meta measure">{t(locale, 'kit.intro')}</p>
    </div>

    <div class="kit__body" data-kit>
      <div class="kit__tabs" role="tablist" aria-label={t(locale, 'kit.selectLabel')}>
        {
          items.map((item, i) => (
            <button
              type="button"
              role="tab"
              class="tab"
              id={`kit-tab-${item.id}`}
              aria-controls={`kit-panel-${item.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tab__name">{item.name}</span>
              <span class="tab__class t-mono">{item.class}</span>
            </button>
          ))
        }
      </div>

      {
        items.map((item, i) => (
          <div
            class="kit__panel"
            role="tabpanel"
            id={`kit-panel-${item.id}`}
            aria-labelledby={`kit-tab-${item.id}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <div class="kit__media">
              <button
                type="button"
                class="frame"
                data-video-src={item.sample.src}
                data-video-label={`${item.name} — ${t(locale, 'kit.sample')}`}
              >
                <span class="frame__media">
                  <MediaPlaceholder
                    ratio={item.sample.orientation === 'vertical' ? '9:16' : '16:9'}
                    label={`${item.name} — ${t(locale, 'kit.sample')}`}
                  />
                </span>
                <span class="frame__play">
                  <Glint height="1.1rem" />
                  <span class="visually-hidden">{t(locale, 'kit.playSample')}</span>
                </span>
              </button>

              {/* The full spec sheet for this item, including the rows that
                  only apply to it. */}
              <dl class="specsList">
                {item.specs.map((spec) => (
                  <div class="specsList__row">
                    <dt>{spec.label}</dt>
                    <dd class="t-mono">{spec.value}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="kit__info">
              <p class="kit__tagline">{item.tagline}</p>

              <div class="kit__lists">
                <div class="kit__list">
                  <h3 class="kit__listTitle t-mono">{t(locale, 'kit.bestFor')}</h3>
                  <ul>
                    {item.bestFor.map((entry) => <li>{entry}</li>)}
                  </ul>
                </div>
                <div class="kit__list">
                  <h3 class="kit__listTitle t-mono">{t(locale, 'kit.limits')}</h3>
                  <ul class="kit__list--limits">
                    {item.limits.map((entry) => <li>{entry}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {
      airframes.length > 1 && (
        <div class="specs">
          <h3 class="specs__caption t-mono">{t(locale, 'kit.compare')}</h3>
          <div class="specs__scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">
                    <span class="visually-hidden">{t(locale, 'kit.compare')}</span>
                  </th>
                  {airframes.map((item) => (
                    <th scope="col" data-spec-col={item.id}>
                      {item.name}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr>
                    <th scope="row">{row}</th>
                    {airframes.map((item) => (
                      <td data-spec-col={item.id}>{valueFor(item, row)}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .kit__head {
    display: grid;
    gap: var(--sp-4);
    margin-block-end: var(--sp-7);
  }

  .kit__body {
    display: grid;
    gap: var(--sp-5);
  }

  @media (min-width: 60rem) {
    .kit__body {
      grid-template-columns: 15rem minmax(0, 1fr);
      grid-template-areas:
        'tabs panel'
        'tabs .';
      gap: var(--sp-6);
      align-items: start;
    }

    .kit__tabs {
      grid-area: tabs;
    }

    .kit__panel {
      grid-area: panel;
    }
  }

  /* --- tabs ---------------------------------------------------------------
     A real tablist. On a phone it is a horizontally scrolling strip, which
     needs no JavaScript — the arrow keys still work because the ARIA pattern
     is unchanged. */
  .kit__tabs {
    display: flex;
    gap: var(--sp-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block-end: var(--sp-2);
    scrollbar-width: none;
  }

  .kit__tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    flex: none;
    scroll-snap-align: start;
    display: grid;
    gap: var(--sp-1);
    min-height: 44px;
    padding: var(--sp-3) var(--sp-4);
    background: none;
    border: var(--hairline) solid var(--line);
    border-radius: 0;
    text-align: start;
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease);
  }

  @media (min-width: 60rem) {
    .kit__tabs {
      flex-direction: column;
      overflow: visible;
      padding-block-end: 0;
    }

    .tab {
      width: 100%;
    }
  }

  .tab:hover {
    border-color: var(--fg-muted);
  }

  /* The tip again: the active tab is marked by a wax edge at its start, not
     by a fill. */
  .tab[aria-selected='true'] {
    border-color: var(--line);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .tab__name {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 28;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.1;
  }

  .tab__class {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  /* --- panel --- */
  .kit__panel {
    display: grid;
    gap: var(--sp-5);
  }

  .kit__panel[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .kit__panel {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--sp-6);
      align-items: start;
    }
  }

  .kit__media {
    min-width: 0;
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .frame__media {
    display: block;
    border: var(--hairline) solid var(--line);
    overflow: hidden;
  }

  .frame__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    translate: -50% -50%;
    background: rgb(5 7 10 / 0.62);
    border: var(--hairline) solid rgb(232 230 225 / 0.35);
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }

  /* :global() because the icon is a child component's root element. */
  .frame :global(.glint) {
    color: var(--silk);
    transition: color var(--dur-2) var(--ease);
  }

  .frame:hover .frame__play,
  .frame:focus-visible .frame__play {
    background: rgb(5 7 10 / 0.85);
    border-color: var(--silk);
  }

  .frame:hover :global(.glint),
  .frame:focus-visible :global(.glint) {
    color: var(--accent);
  }

  .kit__info {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }

  /* This item's own spec sheet, under its clip. */
  .specsList {
    margin: var(--sp-5) 0 0;
    border-block-start: var(--hairline) solid var(--line);
  }

  .specsList__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    border-block-end: var(--hairline) solid var(--line);
  }

  .specsList dt {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .specsList dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .kit__tagline {
    font-size: var(--text-lg);
    line-height: var(--lh-heading);
    max-width: 30ch;
  }

  .kit__lists {
    display: grid;
    gap: var(--sp-5);
  }

  @media (min-width: 80rem) {
    .kit__lists {
      grid-template-columns: 1fr 1fr;
    }
  }

  .kit__listTitle {
    color: var(--accent-text);
    font-size: var(--text-xs);
    margin-block-end: var(--sp-3);
  }

  .kit__list ul {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--fg-muted);
    font-size: var(--text-base);
  }

  .kit__list li {
    padding-inline-start: var(--sp-4);
    position: relative;
  }

  .kit__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    width: 0.35rem;
    height: var(--hairline);
    background: var(--line);
  }

  /* --- spec comparison --- */
  .specs {
    margin-block-start: var(--sp-7);
  }

  .specs__caption {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    margin-block-end: var(--sp-3);
  }

  .specs__scroll {
    overflow-x: auto;
    border-block-start: var(--hairline) solid var(--line);
  }

  table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    text-align: start;
  }

  th,
  td {
    padding: var(--sp-3) var(--sp-4) var(--sp-3) 0;
    text-align: start;
    vertical-align: baseline;
    border-block-end: var(--hairline) solid var(--line);
    font-weight: 400;
  }

  thead th {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 20;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
  }

  tbody th {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
    position: sticky;
    inset-inline-start: 0;
    background: var(--bg);
    padding-inline-end: var(--sp-5);
  }

  tbody td {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--ls-mono);
    color: var(--fg-muted);
    min-width: 9rem;
  }

  /* The active column is marked in wax — the comparison updates with the
     selector rather than being a separate mode. */
  [data-spec-col].is-active {
    color: var(--fg);
  }

  thead [data-spec-col].is-active {
    box-shadow: inset 0 -2px 0 var(--accent);
  }
</style>

<script>
  // ARIA tabs pattern: arrow keys, Home/End, roving tabindex. The comparison
  // table column follows the selection.
  const root = document.querySelector<HTMLElement>('[data-kit]');

  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const section = root.closest('section');

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });

      const id = tabs[index]?.id.replace('kit-tab-', '');
      section?.querySelectorAll('[data-spec-col]').forEach((cell) => {
        cell.classList.toggle('is-active', cell.getAttribute('data-spec-col') === id);
      });

      if (focus) tabs[index]?.focus();
      // Keep the selected tab in view in the mobile scrolling strip.
      tabs[index]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));

      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          next = i === last ? 0 : i + 1;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          next = i === 0 ? last : i - 1;
        } else if (event.key === 'Home') {
          next = 0;
        } else if (event.key === 'End') {
          next = last;
        }

        if (next !== null) {
          event.preventDefault();
          select(next);
        }
      });
    });

    // Mark the initial column without stealing focus on page load.
    const initial = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
    select(initial < 0 ? 0 : initial, false);
  }
</script>
