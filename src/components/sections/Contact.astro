---
import Field from '../ui/Field.astro';
import Button from '../ui/Button.astro';
import { t, localePath, type Locale } from '../../i18n/ui';
import { getSite } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = await getSite();

const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(
  t(locale, 'contact.whatsappPrefill')
)}`;
const optional = t(locale, 'form.optional');

/**
 * The form hands off to WhatsApp rather than posting anywhere. It is where a
 * one-person business in Istanbul actually receives enquiries, it needs no
 * server or spam handling, and it means the site itself never stores anyone's
 * details — which keeps the KVKK notice short.
 *
 * The message is assembled in the browser from the visitor's own input, so the
 * labels travel with it in the visitor's language.
 */
const waLabels = {
  name: t(locale, 'contact.wa.name'),
  business: t(locale, 'contact.wa.business'),
  businessType: t(locale, 'contact.wa.type'),
  message: t(locale, 'contact.wa.message'),
};
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="page">
    <div class="ct__head">
      <h2 id="contact-title">{t(locale, 'contact.heading')}</h2>
      <p class="t-meta measure">{t(locale, 'contact.intro')}</p>
    </div>

    <div class="ct__grid">
      <form
        class="ct__form"
        data-inquiry-form
        novalidate
        data-wa-number={site.whatsapp}
        data-wa-intro={t(locale, 'contact.wa.intro')}
        data-wa-labels={JSON.stringify(waLabels)}
        data-error-required={t(locale, 'contact.error.required')}
        data-error-consent={t(locale, 'contact.error.consent')}
      >
        <Field name="name" label={t(locale, 'contact.form.name')} autocomplete="name" required />
        <Field
          name="business"
          label={t(locale, 'contact.form.business')}
          autocomplete="organization"
          required
        />
        <Field
          name="businessType"
          label={t(locale, 'contact.form.businessType')}
          type="select"
          optionalLabel={optional}
          options={[
            { value: '', label: t(locale, 'form.choose') },
            ...site.businessTypes(locale),
          ]}
        />
        <Field
          name="message"
          label={t(locale, 'contact.form.message')}
          type="textarea"
          hint={t(locale, 'contact.form.messageHint')}
          required
        />

        <!-- No honeypot and no hidden timing field: nothing is posted to a
             server, so there is nothing for a bot to spam. -->

        <div class="ct__consent">
          <input type="checkbox" id="field-consent" name="consent" required />
          <label for="field-consent">{t(locale, 'legal.consent')}</label>
          <a class="ct__policy" href={localePath(locale, '/privacy')}>
            {t(locale, 'legal.privacy')}
          </a>
        </div>

        <Button type="submit" block>{t(locale, 'contact.form.submit')}</Button>

        {/* The button keeps the label people expect, so this line does the
            signposting instead: it says what the click actually does. */}
        <p class="ct__submithint t-meta">{t(locale, 'contact.form.submitHint')}</p>

        <p class="ct__status" data-form-status role="status" aria-live="polite"></p>
      </form>

      <aside class="ct__direct">
        <h3 class="ct__label t-mono">{t(locale, 'contact.directLabel')}</h3>
        <ul class="ct__links">
          <li>
            <a href={waHref} rel="noopener">{t(locale, 'cta.whatsapp')}</a>
            <span class="t-mono">{site.whatsappDisplay}</span>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>{t(locale, 'cta.email')}</a>
            <span class="t-mono">{site.email}</span>
          </li>
          <li>
            <a href={`https://instagram.com/${site.instagram}`} rel="noopener me" target="_blank">
              Instagram
            </a>
            <span class="t-mono">@{site.instagram}</span>
          </li>
        </ul>
        <p class="t-meta">{t(locale, 'trust.serviceArea')}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .ct__head {
    display: grid;
    gap: var(--sp-4);
    margin-block-end: var(--sp-6);
  }

  .ct__grid {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .ct__grid {
      grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
      gap: var(--sp-8);
    }
  }

  .ct__form {
    display: grid;
    gap: var(--sp-5);
  }

  .ct__submithint {
    text-align: center;
  }

  .ct__consent {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-2) var(--sp-3);
    align-items: start;
    padding-block-start: var(--sp-2);
  }

  .ct__consent input {
    width: 1.15rem;
    height: 1.15rem;
    margin-block-start: 0.28em;
    accent-color: var(--accent);
    flex: none;
  }

  .ct__consent label {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* The policy link sits outside the label on purpose: an <a> nested in a
     <label> is ambiguous to click — people expect to read the notice, not
     toggle the checkbox. */
  .ct__policy {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--fg);
  }

  .ct__status:empty {
    display: none;
  }

  .ct__status {
    font-size: var(--text-base);
  }

  .ct__direct {
    display: grid;
    gap: var(--sp-4);
    align-content: start;
    padding-block-start: var(--sp-2);
  }

  .ct__label {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    margin: 0;
  }

  .ct__links {
    display: grid;
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ct__links li {
    display: grid;
    gap: var(--sp-1);
  }

  .ct__links a {
    text-decoration: none;
    border-block-end: var(--hairline) solid var(--line);
    justify-self: start;
    transition: border-color var(--dur-1) var(--ease);
  }

  .ct__links a:hover {
    border-block-end-color: var(--accent);
  }

  .ct__links span {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  // The form does not post anywhere. It validates, assembles a WhatsApp message
  // from what the visitor typed, and opens it. Everything below runs in the
  // visitor's browser; the site never receives or stores their details.
  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');

  if (form) {
    const number = form.dataset.waNumber ?? '';
    const intro = form.dataset.waIntro ?? '';
    const labels = JSON.parse(form.dataset.waLabels || '{}') as Record<string, string>;
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const consent = form.querySelector<HTMLInputElement>('#field-consent');

    const requiredText = form.dataset.errorRequired ?? '';
    const requiredConsent = form.dataset.errorConsent ?? '';

    const clearError = (name: string) => {
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const control = form.querySelector<HTMLElement>(`[name="${name}"]`);
      if (slot) {
        slot.hidden = true;
        slot.textContent = '';
      }
      control?.removeAttribute('aria-invalid');
    };

    const showError = (name: string, message: string) => {
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const control = form.querySelector<HTMLElement>(`[name="${name}"]`);
      if (slot) {
        slot.textContent = message;
        slot.hidden = false;
      }
      control?.setAttribute('aria-invalid', 'true');
    };

    const value = (name: string) =>
      (form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        `[name="${name}"]`
      )?.value ?? '').trim();

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const fields = ['name', 'business', 'message'];
      let firstBad: HTMLElement | null = null;

      for (const field of fields) {
        clearError(field);
        if (!value(field)) {
          showError(field, requiredText);
          firstBad ??= form.querySelector<HTMLElement>(`[name="${field}"]`);
        }
      }

      if (consent && !consent.checked) {
        if (status) status.textContent = requiredConsent;
        firstBad ??= consent;
      } else if (status) {
        status.textContent = '';
      }

      if (firstBad) {
        firstBad.focus();
        return;
      }

      // Locale-aware labels, in the order they were asked for. The business
      // type is optional, so it is dropped rather than sent as a blank line.
      const lines = [
        `${labels.name}: ${value('name')}`,
        `${labels.business}: ${value('business')}`,
      ];

      const typeSelect = form.querySelector<HTMLSelectElement>('[name="businessType"]');
      const typeLabel = typeSelect?.selectedOptions[0]?.textContent?.trim();
      if (typeSelect?.value && typeLabel) lines.push(`${labels.businessType}: ${typeLabel}`);

      lines.push('', `${labels.message}: ${value('message')}`);

      const text = `${intro}\n\n${lines.join('\n')}`;
      window.open(
        `https://wa.me/${number}?text=${encodeURIComponent(text)}`,
        '_blank',
        'noopener'
      );
    });

    // Clearing as they type, so the error does not outlive the mistake.
    form.addEventListener('input', (event) => {
      const name = (event.target as HTMLElement).getAttribute?.('name');
      if (name) clearError(name);
    });
  }
</script>
