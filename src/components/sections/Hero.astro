---
import Button from '../ui/Button.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    {/*
      Poster-first. The still is the LCP element and paints immediately; the
      loop loads only after that and fades in behind the type. A video as the
      LCP would blow the budget on the one metric that matters most here.

      <picture> handles the portrait swap for the still, because <source
      media> inside <picture> is reliable — unlike inside <video>, where
      Safari ignores it and the swap has to be done in script.
    */}
    <picture>
      <source
        media="(max-width: 47.999rem)"
        srcset="/video/hero-portrait.jpg"
        width="480"
        height="854"
      />
      <img
        class="hero__poster"
        src="/video/hero-landscape.jpg"
        width="960"
        height="540"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <video
      class="hero__video"
      data-hero-video
      data-src-landscape="/video/hero-landscape.mp4"
      data-src-portrait="/video/hero-portrait.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"></video>
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner page">
    <div class="hero__row">
      <h1 class="hero__title" id="hero-title">{t(locale, 'site.tagline')}</h1>

      <div class="hero__actions">
        <Button href="#contact">{t(locale, 'cta.quote')}</Button>
        <Button href="#work" variant="quiet">{t(locale, 'cta.watchReel')}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* svh, not vh: on iOS Safari a vh hero is taller than the visible area
       while the URL bar is showing, which pushes the type off-screen. */
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-block-end: var(--hairline) solid var(--line);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--mask);
  }

  .hero__media picture,
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__poster,
  .hero__video {
    object-fit: cover;
  }

  /* The loop arrives late and quietly, and no layout depends on it. */
  .hero__video {
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease);
  }

  .hero__video.is-ready {
    opacity: 1;
  }

  /* Text sits on footage, so it needs its own ground. Weighted to the bottom
     where the type actually is, rather than a full-height wash. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(5 7 10 / 0.92) 0%,
      rgb(5 7 10 / 0.72) 32%,
      rgb(5 7 10 / 0.18) 62%,
      rgb(5 7 10 / 0.34) 100%
    );
  }

  .hero__inner {
    position: relative;
    width: 100%;
    padding-block: var(--sp-7) var(--sp-6);
  }

  .hero__row {
    display: grid;
    gap: var(--sp-6);
    align-items: end;
  }

  /* display-md, not display-lg. The pitch is a full sentence in two
     languages, and Turkish compounds are long — at display-lg this ran to
     five lines and pushed the button below the fold. */
  .hero__title {
    max-width: 26ch;
    font-size: var(--display-md);
    line-height: var(--lh-display);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
  }

  @media (min-width: 60rem) {
    /* The composition spreads across the full width rather than stacking in
       the centre: the pitch holds the left, the actions sit on the right
       baseline. */
    .hero__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hero__title {
      max-width: 24ch;
    }

    .hero__actions {
      justify-content: flex-end;
    }
  }
</style>

<script>
  // The loop is opt-in, not automatic. It is skipped entirely for anyone who
  // has asked for reduced motion, has Data Saver on, or is on a slow
  // connection — in every one of those cases the poster is already there and
  // is the whole hero.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (video) {
    const connection = (navigator as any).connection;
    const skip =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      connection?.saveData === true ||
      /(^|-)2g$/.test(connection?.effectiveType ?? '');

    if (!skip) {
      const portrait = window.matchMedia('(max-width: 47.999rem)').matches;
      video.src = portrait
        ? (video.dataset.srcPortrait ?? '')
        : (video.dataset.srcLandscape ?? '');
      video.preload = 'auto';

      video.addEventListener(
        'canplay',
        () => {
          video.classList.add('is-ready');
          video.play().catch(() => {
            /* Refused. The poster stays, which is a complete hero. */
          });
        },
        { once: true }
      );

      video.load();
    }
  }
</script>
