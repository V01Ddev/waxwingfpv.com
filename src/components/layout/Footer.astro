---
import Wordmark from '../brand/Wordmark.astro';
import { t, localePath, type Locale } from '../../i18n/ui';
import { getSite } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = await getSite();

const year = new Date().getFullYear();
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(
  t(locale, 'contact.whatsappPrefill')
)}`;
---

<footer class="ftr">
  <div class="page">
    <hr class="rule" />

    <div class="ftr__grid">
      <div class="ftr__brand">
        <Wordmark variant="grey" />
        <p class="t-meta">{t(locale, 'trust.serviceArea')}</p>
      </div>

      <nav class="ftr__col" aria-label={t(locale, 'contact.directLabel')}>
        <h2 class="ftr__label t-mono">{t(locale, 'contact.directLabel')}</h2>
        <ul class="ftr__list">
          {/* No dashes between the label and the value: the typeface change
              does the separating, which is the same rule the rest of the site
              follows: mono is for data. */}
          <li>
            {/* Counted by GoatCounter's own click binding, which scans for this
                attribute when count.js runs. A click before that is not
                counted; nothing here can change that without loading the
                script eagerly, which would cost more than it returns.

                The title is set explicitly and in English on purpose: without
                it count.js falls back to the element's innerHTML, which here
                is the phone number wrapped in a span complete with Astro's
                scope attribute. A localised title would also split the same
                event into two rows in the dashboard. */}
            <a
              href={waHref}
              rel="noopener"
              data-goatcounter-click="whatsapp-footer"
              data-goatcounter-title="WhatsApp (footer)"
            >
              WhatsApp <span class="ftr__value">{site.whatsappDisplay}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <span class="ftr__value">{site.email}</span>
            </a>
          </li>
          <li>
            <a
              href={`https://instagram.com/${site.instagram}`}
              rel="noopener me"
              target="_blank"
            >
              Instagram <span class="ftr__value">@{site.instagram}</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="ftr__col">
        <h2 class="ftr__label t-mono">{t(locale, 'trust.heading')}</h2>
        <p class="t-meta">{t(locale, 'trust.checklist')}</p>
      </div>
    </div>

    <hr class="rule" />

    <div class="ftr__base">
      <p class="t-meta">© {year} WaxWingFPV. {t(locale, 'legal.rights')}</p>
      <a class="t-meta" href={localePath(locale, '/privacy')}>{t(locale, 'legal.privacy')}</a>
      {/*
        The whole phrase is the link rather than just the domain. Turkish puts
        the verb after it — "v01d.dev tarafından yapıldı" — so linking only
        "v01d.dev" would need different markup per locale for no gain.

        target/rel match the Instagram link: it leaves the site, and rel="me"
        makes the same identity claim.
      */}
      <a class="t-meta" href="https://v01d.dev" rel="noopener me" target="_blank">
        {t(locale, 'legal.credit')}
      </a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: var(--sp-7) var(--sp-6);
  }

  .ftr__grid {
    display: grid;
    gap: var(--sp-6);
    padding-block: var(--sp-6);
  }

  @media (min-width: 48rem) {
    .ftr__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: var(--sp-7);
    }
  }

  .ftr__brand {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
  }

  .ftr__col {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }

  .ftr__label {
    color: var(--fg-muted);
    margin: 0;
  }

  .ftr__list {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ftr__list a {
    color: var(--fg-muted);
    text-decoration: none;
    border-block-end: var(--hairline) solid transparent;
    transition:
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }

  /* The label is a signpost; the number, the address and the handle are the
     content, so they carry the brightness. */
  .ftr__value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-mono);
    font-size: 0.94em;
    color: var(--fg);
  }

  .ftr__list a:hover {
    border-block-end-color: var(--fg);
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-5);
    padding-block-start: var(--sp-5);
  }

  .ftr__base a {
    text-decoration: none;
  }

  .ftr__base a:hover {
    color: var(--fg);
  }
</style>
